generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum VoucherType {
  PAYMENT
  RECEIPT
  JOURNAL
  KACHI
  SALE_INVOICE
  PURCHASE_INVOICE
}

enum VoucherStatus {
  ACTIVE
  CANCELLED
  PENDING_APPROVAL
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum LedgerEntryType {
  DEBIT
  CREDIT
}

enum FinancialYearStatus {
  ACTIVE
  CLOSED
}

enum InvoiceType {
  KACHI_MAAL
  SALE_INVOICE
  PURCHASE_INVOICE
  STOCK_TRANSFER
  OPENING_STOCK
}

enum InvoiceStatus {
  DRAFT
  POSTED
  CANCELLED
  PENDING_APPROVAL
}

enum RecordStatus {
  ACTIVE
  PENDING_APPROVAL
  REJECTED
}

enum PendingAdjustmentKind {
  ACCOUNT
  STOCK
}

enum JamaNaamDirection {
  JAMA
  NAAM
}

enum Role {
  ADMIN
  USER
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  displayName  String?
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  vouchersCreated  Voucher[]              @relation("VoucherCreatedBy")
  vouchersModified Voucher[]              @relation("VoucherModifiedBy")
  vouchersDeleted  Voucher[]              @relation("VoucherDeletedBy")
  financialYearsClosed FinancialYear[]    @relation("FinancialYearClosedBy")
  financialYearsChanged FinancialYear[]   @relation("FinancialYearChangedBy")
  trialBalanceApprovals TrialBalanceApproval[]
  invoicesCreated       Invoice[]
  accountsCreated       Account[]              @relation("AccountCreatedBy")
  productsCreated       Product[]              @relation("ProductCreatedBy")
  pendingAdjustments    PendingAdjustment[]
}

model Supplier {
  id            Int      @id @default(autoincrement())
  name          String
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  invoices Invoice[]

  @@index([isActive, name])
}

model Customer {
  id         Int      @id @default(autoincrement())
  name       String
  fatherName String?
  cnic       String?  @unique
  phone      String?
  email      String?
  address    String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  invoices Invoice[]

  @@index([isActive, name])
}

model AccountCategory {
  id        Int      @id @default(autoincrement())
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  accounts Account[]

  @@index([isActive])
}

model Account {
  id                   Int          @id @default(autoincrement())
  categoryId           Int
  name                 String
  code                 String       @unique
  type                 AccountType
  isActive             Boolean      @default(true)
  excludeFromSelectors Boolean      @default(false)
  status               RecordStatus @default(ACTIVE)
  createdById          Int?
  pendingOpeningBalance Decimal?
  pendingOpeningSide   String?
  createdAt            DateTime     @default(now())

  category        AccountCategory               @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdBy       User?                         @relation("AccountCreatedBy", fields: [createdById], references: [id])
  ledger          Ledger?
  debitVouchers   Voucher[]                     @relation("DebitAccount")
  creditVouchers  Voucher[]                     @relation("CreditAccount")
  closingBalances FinancialYearClosingBalance[]
  product              Product?
  kachiMaalLines         KachiMaalLine[]   @relation("KachiMaalPartyAccount")
  kachiMaalDebitInvoices   Invoice[]         @relation("KachiMaalDebitAccount")
  jamaNaamEntries        JamaNaamEntry[]
  pendingAdjustments     PendingAdjustment[]

  @@index([categoryId])
  @@index([isActive, categoryId])
  @@index([status])
}

model Ledger {
  id        Int      @id @default(autoincrement())
  accountId Int      @unique
  balance   Decimal  @default(0)
  updatedAt DateTime @updatedAt

  account Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  entries LedgerEntry[]
}

model LedgerEntry {
  id               Int             @id @default(autoincrement())
  ledgerId         Int
  voucherId        Int?
  type             LedgerEntryType
  amount           Decimal
  balance          Decimal
  notes            String?
  /** Flat Mazduri portion of a product debit (Purchase Invoice); debit-side reporting only. */
  mazduriAmount    Decimal?
  isReversal       Boolean         @default(false)
  isOpeningBalance Boolean         @default(false)
  createdAt        DateTime        @default(now())
  /**
   * Effective transaction date used for chronological ordering and
   * date-range filtering in ledger/report queries.
   *
   * Always populated at creation time for non-voucher sources too.
   */
  date             DateTime        @default(now())
  financialYearId  Int?

  ledger        Ledger         @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  voucher       Voucher?       @relation(fields: [voucherId], references: [id])
  financialYear FinancialYear? @relation(fields: [financialYearId], references: [id])

  @@index([ledgerId])
  @@index([voucherId])
  @@index([createdAt])
  @@index([date])
  @@index([ledgerId, createdAt])
  @@index([ledgerId, date])
  @@index([ledgerId, id])
  @@index([financialYearId])
}

model Voucher {
  id              Int           @id @default(autoincrement())
  type            VoucherType
  number          Int
  date            DateTime
  debitAccountId  Int?
  creditAccountId Int?
  amount          Decimal
  description     String?
  reference       String?
  status          VoucherStatus @default(ACTIVE)
  createdById     Int
  modifiedById    Int?
  deletedById     Int?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?
  financialYearId Int?

  financialYear FinancialYear? @relation(fields: [financialYearId], references: [id])
  debitAccount  Account?       @relation("DebitAccount", fields: [debitAccountId], references: [id], onDelete: Restrict)
  creditAccount Account?       @relation("CreditAccount", fields: [creditAccountId], references: [id], onDelete: Restrict)
  createdBy     User           @relation("VoucherCreatedBy", fields: [createdById], references: [id])
  modifiedBy    User?          @relation("VoucherModifiedBy", fields: [modifiedById], references: [id])
  deletedBy     User?          @relation("VoucherDeletedBy", fields: [deletedById], references: [id])
  ledgerEntries LedgerEntry[]
  invoiceLink   InvoiceVoucher?

  @@unique([financialYearId, type, number])
  @@index([financialYearId, type])
  @@index([debitAccountId])
  @@index([creditAccountId])
  @@index([date])
  @@index([createdAt])
  @@index([status])
  @@index([financialYearId, type, status, date])
}

model FinancialYear {
  id         Int                 @id @default(autoincrement())
  label      String              @unique
  startDate  DateTime
  endDate    DateTime?
  status     FinancialYearStatus @default(ACTIVE)
  closedAt   DateTime?
  closedById Int?
  changedAt  DateTime?
  changedById Int?

  closedBy        User?                         @relation("FinancialYearClosedBy", fields: [closedById], references: [id])
  changedBy       User?                         @relation("FinancialYearChangedBy", fields: [changedById], references: [id])
  closingBalances FinancialYearClosingBalance[]
  vouchers        Voucher[]
  invoices        Invoice[]
  ledgerEntries   LedgerEntry[]

  @@index([status])
}

model FinancialYearClosingBalance {
  id              Int     @id @default(autoincrement())
  financialYearId Int
  accountId       Int
  balance         Decimal
  computedAt      DateTime @default(now())

  financialYear FinancialYear @relation(fields: [financialYearId], references: [id], onDelete: Cascade)
  account       Account       @relation(fields: [accountId], references: [id])

  @@unique([financialYearId, accountId])
}

model TrialBalanceApproval {
  id           Int      @id @default(autoincrement())
  period       String   @unique
  approvedById Int
  notes        String?
  snapshot     Json
  createdAt    DateTime @default(now())

  approvedBy User @relation(fields: [approvedById], references: [id])
}

model Product {
  id         Int          @id @default(autoincrement())
  name       String
  code       String       @unique
  unit       String?
  kind       ProductKind  @default(STANDARD)
  accountId  Int          @unique
  categoryId Int?
  isActive   Boolean      @default(true)
  status     RecordStatus @default(ACTIVE)
  /** Weighted average cost per unit across ALL stock sources. */
  averageCost Decimal?
  createdById Int?
  pendingOpeningStoreId Int?
  pendingOpeningQty     Decimal?
  pendingOpeningRate    Decimal?
  pendingKachiOpening   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  account         Account           @relation(fields: [accountId], references: [id], onDelete: Restrict)
  category        ProductCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdBy       User?             @relation("ProductCreatedBy", fields: [createdById], references: [id])
  invoiceItems    InvoiceItem[]
  invoices        Invoice[]
  stockMovements  StockMovement[]
  stockRemainders StockRemainder[]
  jamaNaamEntries JamaNaamEntry[]
  pendingAdjustments PendingAdjustment[]

  @@index([categoryId])
  @@index([isActive, name])
  @@index([status])
}

model ProductCategory {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  products  Product[]
}

model Invoice {
  id              Int           @id @default(autoincrement())
  type            InvoiceType
  status          InvoiceStatus @default(DRAFT)
  reference       String
  customerId      Int?
  supplierId      Int?
  total           Decimal       @default(0)
  notes           String?
  invoiceDate     DateTime?
  billNo          String?
  gariNo          String?
  jins            String?
  qism            String?
  tafseel         String?
  debitAccountId  Int?
  miscAmount      Decimal       @default(0)
  productId              Int?
  storeId                Int?
  toStoreId              Int?
  legacyInventoryPosting Boolean       @default(false)
  financialYearId Int?
  createdById     Int
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  customer      Customer?     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  supplier      Supplier?     @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  debitAccount  Account?      @relation("KachiMaalDebitAccount", fields: [debitAccountId], references: [id], onDelete: Restrict)
  product       Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  store         Store?        @relation("InvoiceStore", fields: [storeId], references: [id], onDelete: SetNull)
  toStore       Store?        @relation("InvoiceToStore", fields: [toStoreId], references: [id], onDelete: SetNull)
  financialYear FinancialYear? @relation(fields: [financialYearId], references: [id])
  createdBy     User          @relation(fields: [createdById], references: [id])
  items         InvoiceItem[]
  vouchers      InvoiceVoucher[]
  kachiMaalLines KachiMaalLine[]
  stockMovements StockMovement[]

  @@unique([financialYearId, reference])
  @@index([financialYearId])
  @@index([financialYearId, type, status])
  @@index([createdAt])
  @@index([status])
  @@index([storeId])
  @@index([customerId])
  @@index([supplierId])
  @@index([invoiceDate])
  @@index([type, status])
}

model KachiMaalLine {
  id               Int           @id @default(autoincrement())
  invoiceId        Int
  partyAccountId   Int
  jins             String?
  qism             String?
  bagCount         Decimal       @default(0)
  bhartii          Decimal       @default(0)
  dharanCount      Decimal       @default(0)
  looseKg          Decimal       @default(0)
  totalWeightKg    Decimal       @default(0)
  ratePerMaund     Decimal       @default(0)
  amount           Decimal       @default(0)
  netCreditToParty Decimal       @default(0)
  sortOrder        Int           @default(0)

  invoice      Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  partyAccount Account @relation("KachiMaalPartyAccount", fields: [partyAccountId], references: [id], onDelete: Restrict)

  @@index([invoiceId])
  @@index([partyAccountId])
}

model SystemPreference {
  id                Int      @id @default(1)
  daamiPercent      Decimal  @default(0)
  paleDariPercent   Decimal  @default(0)
  brokeryPercent    Decimal  @default(0)
  marketFeeRate     Decimal  @default(0)
  marketFeeEnabled  Boolean  @default(true)
  taxPercent        Decimal  @default(0)
  markeetFeeRate    Decimal  @default(0)
  kantaRate         Decimal  @default(0)
  closingDate       String?
  updatedAt         DateTime @updatedAt
}

model InvoiceItem {
  id            Int     @id @default(autoincrement())
  invoiceId     Int
  productId     Int?
  label         String
  quantity      Decimal @default(0)
  unitPrice     Decimal @default(0)
  total         Decimal @default(0)
  /** Flat labor fee for Purchase Invoice lines (not qty × rate). */
  mazduriAmount Decimal @default(0)

  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([productId])
}

model InvoiceVoucher {
  id        Int @id @default(autoincrement())
  invoiceId Int
  voucherId Int @unique

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  voucher Voucher @relation(fields: [voucherId], references: [id])

  @@index([invoiceId])
}

enum ProductKind {
  STANDARD
  KACHI
}

enum StockDirection {
  IN
  OUT
}

/** Physical stores used by Sale Invoice / Purchase Invoice stock only. */
model Store {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  stockMovements  StockMovement[]
  stockRemainders StockRemainder[]
  invoicesFrom    Invoice[] @relation("InvoiceStore")
  invoicesTo      Invoice[] @relation("InvoiceToStore")
  pendingAdjustments PendingAdjustment[]
}

model PendingAdjustment {
  id             Int                   @id @default(autoincrement())
  kind           PendingAdjustmentKind
  status         RecordStatus          @default(PENDING_APPROVAL)
  adjustmentDate DateTime
  createdById    Int
  createdAt      DateTime              @default(now())
  accountId      Int?
  amount         Decimal?
  side           String?
  productId      Int?
  storeId        Int?
  quantity       Decimal?
  rate           Decimal?
  kachiOpening   Json?

  createdBy User     @relation(fields: [createdById], references: [id])
  account   Account? @relation(fields: [accountId], references: [id], onDelete: Cascade)
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  store     Store?   @relation(fields: [storeId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([kind, status])
}

model StockRemainder {
  id           Int          @id @default(autoincrement())
  productId    Int
  storeId      Int?
  remainderKg  Decimal      @default(0)
  updatedAt    DateTime     @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  store   Store?  @relation(fields: [storeId], references: [id])

  @@unique([productId, storeId])
  @@index([productId])
  @@index([storeId])
}

model StockMovement {
  id               Int            @id @default(autoincrement())
  productId        Int
  storeId          Int?
  direction        StockDirection
  bags             Decimal
  /** Kachi products track precise kg here; STANDARD products leave null and use bags. */
  weightKg         Decimal?
  date             DateTime
  invoiceId        Int?
  invoiceType      InvoiceType
  invoiceReference String
  description      String?
  isOpeningStock   Boolean        @default(false)
  createdAt        DateTime       @default(now())

  product Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  store   Store?   @relation(fields: [storeId], references: [id])
  invoice Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([productId, date, id])
  @@index([invoiceId])
  @@index([storeId])
}

/** Informal borrow/lend register — isolated from ledger, stock, and invoices. */
model JamaNaamEntry {
  id        Int               @id @default(autoincrement())
  partyId   Int
  productId Int?
  quantity  Decimal?
  amount    Decimal?
  direction JamaNaamDirection
  date      DateTime
  notes     String?
  createdAt DateTime          @default(now())

  party   Account  @relation(fields: [partyId], references: [id], onDelete: Restrict)
  product Product? @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([date, id])
  @@index([partyId])
  @@index([productId])
}
